# ── Tengu storefront — environment variables ─────────────────────────────
# Copy to `.env` and fill in real values. `.env` is gitignored.

# MongoDB connection string (Atlas or local). Used by both the storefront
# and the admin console.
DATABASE_URI=mongodb://localhost:27017/tengu

# Secrets used to sign admin (/manage) and customer session JWTs.
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a development-only fallback is used and a warning is logged.
# CHANGE THESE before deploying to production.
ADMIN_JWT_SECRET=
APP_JWT_SECRET=

# Public origin of the deployed site. Used for canonical URLs, sitemap.xml,
# robots.txt and OpenGraph image URLs. Set the production domain here for the
# deploy build (e.g. https://shop.example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy Payload CMS secret (kept for compatibility; safe to rotate).
PAYLOAD_SECRET=

# Google OAuth (optional — enables "Continue with Google" sign-in).
# Create credentials in Google Cloud Console: APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
